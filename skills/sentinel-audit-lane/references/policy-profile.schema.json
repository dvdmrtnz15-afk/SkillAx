{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillax.local/sentinel/policy-profile.schema.json",
  "title": "Sentinel policy profile",
  "type": "object",
  "required": ["profile_id", "owner", "purpose", "engine_pin", "exclude_paths", "nonclaims"],
  "additionalProperties": false,
  "properties": {
    "profile_id": { "type": "string" },
    "owner": { "type": "string" },
    "purpose": { "type": "string" },
    "engine_pin": { "type": "string", "description": "Immutable SkillAx commit SHA or local-tree." },
    "exclude_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_write_globs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nonclaims": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
