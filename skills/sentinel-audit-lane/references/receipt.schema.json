{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillax.local/sentinel/receipt.schema.json",
  "title": "Sentinel ContextReceipt",
  "type": "object",
  "required": [
    "receipt_class",
    "authority",
    "effect_authority",
    "repo",
    "revision",
    "engine_pin",
    "policy_digest",
    "findings",
    "conflicts",
    "omissions",
    "freshness",
    "dedupe",
    "nonclaims",
    "content_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "receipt_class": { "const": "ContextReceipt" },
    "authority": { "const": "none" },
    "effect_authority": { "const": "none" },
    "repo": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "engine_pin": { "type": "string", "minLength": 1 },
    "policy_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "freshness": { "enum": ["current", "stale", "unknown"] },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "omissions": { "type": "array", "items": { "type": "string" } },
    "dedupe": {
      "type": "object",
      "required": ["delivery_id", "situation_id", "occurrence_id"],
      "additionalProperties": false,
      "properties": {
        "delivery_id": { "type": "string" },
        "situation_id": { "type": "string" },
        "occurrence_id": { "type": "string" }
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "severity", "rule", "path", "detail"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "severity": { "enum": ["info", "warn", "fail"] },
        "rule": { "type": "string" },
        "path": { "type": "string" },
        "detail": { "type": "string" }
      }
    }
  }
}
