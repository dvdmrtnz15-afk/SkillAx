{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truenorthapplications.com/schemas/local-repos.v1.schema.json",
  "title": "TrueNorth Federation Sentinel Local Repository Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repositories"],
  "properties": {
    "schema": {"const": "truenorth.federation-sentinel.local-repos.v1"},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "expected_remote", "policy_sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$", "not": {"const": "_fleet"}},
          "path": {"type": "string", "minLength": 2, "pattern": "^/"},
          "expected_remote": {
            "type": "string",
            "pattern": "^(https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?|git@github\\.com:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?)$"
          },
          "policy_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
          "scope": {"const": "full", "default": "full"}
        }
      }
    }
  }
}
